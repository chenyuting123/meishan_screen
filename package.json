{
  "name": "hongjin",
  "version": "5.0.0",
  "description": "新金融大数据监测预警平台",
  "scripts": {
    "build:dev": "webpack --config webpack.config.dev.babel.js --colors --display-error-details",
    "build:prod": "webpack --config webpack.config.prod.babel.js --colors --display-error-details",
    "start": "webpack-dev-server --config webpack.config.dev.babel.js --colors",
    "start:mock": "node ./mockServer/server.js",
    "lint:js": "eslint -c .eslintrc.prod.json --ext .js,.jsx src/ --fix",
    "package": "npm run build:prod && gulp zip",
    "release:dev": "npm run build:prod && gulp release_dev",
    "release:test": "npm run build:prod && gulp release_test",
    "release:all": "npm run build:prod && gulp"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "linters": {
      "src/**/*.{js,jsx}": [
        "eslint -c .eslintrc.prod.json --fix",
        "git add"
      ]
    },
    "ignore": []
  },
  "dependencies": {
    "antd": "^2.11.0",
    "axios": "^0.15.3",
    "babel-runtime": "^6.23.0",
    "classnames": "^2.2.5",
    "d3": "^3.5.17",
    "echarts": "^3.4.0",
    "echarts-liquidfill": "^1.0.4",
    "immutable": "^3.8.1",
    "jquery": "^2.1.1",
    "lodash": "^4.17.4",
    "mtui": "^2.4.54",
    "perfect-scrollbar": "^0.6.16",
    "react": "^15.4.2",
    "react-dom": "^15.4.2",
    "react-redux": "^5.0.3",
    "react-router": "^3.0.2",
    "react-router-redux": "^4.0.8",
    "reactjs-iscroll": "^0.3.2",
    "redux": "^3.6.0",
    "redux-thunk": "^2.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^6.7.2",
    "babel-core": "^6.22.1",
    "babel-eslint": "^7.1.1",
    "babel-loader": "^6.2.10",
    "babel-plugin-import": "^1.1.0",
    "babel-plugin-transform-runtime": "^6.22.0",
    "babel-polyfill": "^6.23.0",
    "babel-preset-es2015": "^6.22.0",
    "babel-preset-react": "^6.22.0",
    "babel-preset-stage-0": "^6.22.0",
    "case-sensitive-paths-webpack-plugin": "^2.2.0",
    "clean-webpack-plugin": "^0.1.15",
    "copy-webpack-plugin": "^4.0.1",
    "css-loader": "^0.26.1",
    "del": "^2.2.2",
    "eslint": "^3.17.1",
    "eslint-loader": "^1.6.3",
    "eslint-plugin-react": "^6.10.0",
    "extract-text-webpack-plugin": "^2.0.0-rc.3",
    "file-loader": "^0.10.0",
    "gulp": "^3.9.1",
    "gulp-batch-replace": "0.0.0",
    "gulp-sftp": "^0.1.5",
    "gulp-zip": "^4.0.0",
    "html-webpack-plugin": "^2.28.0",
    "http-proxy-middleware": "^0.17.4",
    "husky": "^1.3.1",
    "json-loader": "^0.5.4",
    "lint-staged": "^8.1.5",
    "mockjs": "^1.0.1-beta3",
    "node-sass": "^4.5.0",
    "open-browser-webpack-plugin": "0.0.5",
    "postcss-loader": "^1.2.2",
    "precss": "^1.4.0",
    "react-addons-perf": "^15.4.2",
    "react-hot-loader": "^1.3.1",
    "sass-loader": "^5.0.1",
    "style-loader": "^0.13.1",
    "uglifyjs-webpack-plugin": "^0.2.1",
    "url-loader": "^0.5.7",
    "webpack": "^2.3.2",
    "webpack-bundle-analyzer": "^3.3.2",
    "webpack-dev-server": "^2.3.0",
    "webpack-merge": "^4.1.0"
  },
  "config": {
    "host": "0.0.0.0",
    "port": 8001,
    "proxy": "http://192.168.1.151:8080",
    "mock": "http://localhost:8000",
    "enableMock": false
  }
}
